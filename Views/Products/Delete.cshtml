@model PharmacyIMS.Models.Product
@{
    ViewData["Title"] = "حذف منتج";
}

<h3 class="fw-bold mb-4 text-danger"><i class="bi bi-exclamation-triangle me-2"></i>تأكيد الحذف</h3>

<div class="alert alert-warning">هل أنت متأكد من رغبتك في حذف هذا المنتج؟</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">SKU</dt>
            <dd class="col-sm-9">@Model.SKU</dd>
            <dt class="col-sm-3">اسم المنتج</dt>
            <dd class="col-sm-9">@Model.ProductName</dd>
            <dt class="col-sm-3">الفئة</dt>
            <dd class="col-sm-9">@Model.Category?.CategoryName</dd>
            <dt class="col-sm-3">الكمية</dt>
            <dd class="col-sm-9">@Model.StockQuantity</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="ProductID" />
    <button type="submit" class="btn btn-danger" onclick="return confirmDelete('سيتم حذف هذا المنتج نهائياً، هل أنت متأكد؟');">
        <i class="bi bi-trash me-1"></i> نعم، احذف
    </button>
    <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
</form>
