@model Sale
@{
    ViewData["Title"] = "تفاصيل الفاتورة";
}

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <h3 class="fw-bold"><i class="bi bi-receipt me-2"></i>فاتورة بيع #@Model.SaleID.ToString("D5")</h3>
    <div>
        <button type="button" class="btn btn-primary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> طباعة الفاتورة
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right me-1"></i> عودة لسجل المبيعات
        </a>
    </div>
</div>

<div class="card invoice-card">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
            <div>
                <h4 class="fw-bold mb-0"><i class="bi bi-capsule-pill text-info me-1"></i> PharmacyIMS</h4>
                <small class="text-muted">نظام إدارة مخزون الصيدلية</small>
            </div>
            <div class="text-end">
                <h5 class="mb-1">فاتورة رقم: #@Model.SaleID.ToString("D5")</h5>
                <div class="text-muted">التاريخ: @Model.SaleDate.ToString("yyyy-MM-dd HH:mm")</div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <strong>بيانات العميل:</strong>
                <div>@(string.IsNullOrWhiteSpace(Model.CustomerInfo) ? "عميل نقدي" : Model.CustomerInfo)</div>
            </div>
            <div class="col-md-6 text-md-end">
                <strong>عدد الأصناف:</strong> @Model.SaleItems.Count
                &nbsp;|&nbsp;
                <strong>إجمالي الكمية:</strong> @Model.SaleItems.Sum(i => i.Quantity)
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>المنتج / الدواء</th>
                        <th>SKU</th>
                        <th>الكمية</th>
                        <th>سعر الوحدة</th>
                        <th>الإجمالي الفرعي</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rowNum = 1; }
                    @foreach (var item in Model.SaleItems)
                    {
                        <tr>
                            <td>@(rowNum++)</td>
                            <td>@(item.Product?.ProductName ?? "منتج محذوف")</td>
                            <td>@(item.Product?.SKU)</td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitPrice.ToString("N2") ج.م</td>
                            <td>@item.LineTotal.ToString("N2") ج.م</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="5" class="text-end fw-bold fs-5">الإجمالي الكلي</td>
                        <td class="fw-bold fs-5">@Model.TotalAmount.ToString("N2") ج.م</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="text-center text-muted mt-4 pt-3 border-top">
            شكرًا لتعاملكم معنا
        </div>
    </div>
</div>

<style>
    @@media print {
        .no-print, nav, .sidebar, #sidebar, .navbar, .toast-container {
            display: none !important;
        }

        .invoice-card {
            border: none !important;
            box-shadow: none !important;
        }

        #page-content-wrapper, main, body, html {
            margin: 0 !important;
            padding: 0 !important;
        }
    }
</style>
