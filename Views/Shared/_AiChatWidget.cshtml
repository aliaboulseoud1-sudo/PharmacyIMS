@if (User.Identity?.IsAuthenticated == true)
{
    <div id="aiWidgetRoot">
        <button type="button" id="aiWidgetFab" class="ai-widget-fab" title="المساعد الذكي" aria-label="فتح المساعد الذكي">
            <i class="bi bi-robot"></i>
            <span class="ai-widget-fab-pulse"></span>
        </button>

        <div id="aiWidgetPanel" class="ai-widget-panel d-none">
            <div class="ai-widget-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-robot fs-5"></i>
                    <div>
                        <div class="fw-bold small">المساعد الذكي (Gemini AI)</div>
                        <div class="ai-widget-status"><span class="ai-widget-dot"></span> متصل</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <button type="button" id="aiWidgetMinimizeBtn" class="ai-widget-icon-btn" title="تصغير" aria-label="تصغير">
                        <i class="bi bi-dash-lg"></i>
                    </button>
                    <button type="button" id="aiWidgetCloseBtn" class="ai-widget-icon-btn" title="إغلاق" aria-label="إغلاق">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <div id="aiWidgetMessages" class="ai-widget-messages">
                <div class="ai-widget-msg assistant">
                    مرحباً! أنا المساعد الذكي لصيدليتك. اسألني عن المخزون أو الأصناف الناقصة أو أداء المبيعات والمشتريات.
                </div>
            </div>

            <div class="ai-widget-chips" id="aiWidgetChips">
                <button type="button" class="ai-widget-chip" data-question="ما هي الأدوية التي أوشكت على النفاد؟">ما هي الأدوية الناقصة؟</button>
                <button type="button" class="ai-widget-chip" data-question="ملخص أداء المبيعات والمشتريات هذا الشهر.">ملخص الشهر الحالي</button>
                <button type="button" class="ai-widget-chip" data-question="ما هي الأصناف الأكثر مبيعاً؟">الأكثر مبيعاً</button>
                <button type="button" class="ai-widget-chip" data-question="كم إجمالي قيمة المخزون الحالي؟">إجمالي المخزون</button>
            </div>

            <form id="aiWidgetForm" class="ai-widget-input-area" autocomplete="off">
                @Html.AntiForgeryToken()
                <input type="text" id="aiWidgetInput" class="form-control form-control-sm" placeholder="اكتب سؤالك هنا..." maxlength="1000" required />
                <button type="submit" id="aiWidgetSendBtn" class="ai-widget-send-btn" title="إرسال" aria-label="إرسال">
                    <i class="bi bi-send-fill" id="aiWidgetSendIcon"></i>
                    <span class="spinner-border spinner-border-sm d-none" id="aiWidgetSpinner" role="status" aria-hidden="true"></span>
                </button>
            </form>
        </div>
    </div>

    <style>
        /* ================= AI Chat Widget (scoped, self-contained) ================= */
        .ai-widget-fab {
            position: fixed;
            inset-inline-end: 1.5rem;
            bottom: 1.5rem;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, #0d6efd, #0a58ca);
            color: #fff;
            border: none;
            font-size: 1.6rem;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 6px 20px rgba(13, 110, 253, 0.45);
            z-index: 1090;
            cursor: pointer;
            transition: transform 0.15s ease;
        }

        .ai-widget-fab:hover {
            transform: scale(1.06);
        }

        .ai-widget-fab-pulse {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            box-shadow: 0 0 0 0 rgba(13, 110, 253, 0.55);
            animation: ai-widget-pulse 2.2s infinite;
            pointer-events: none;
        }

        @@keyframes ai-widget-pulse {
            0% { box-shadow: 0 0 0 0 rgba(13, 110, 253, 0.55); }
            70% { box-shadow: 0 0 0 16px rgba(13, 110, 253, 0); }
            100% { box-shadow: 0 0 0 0 rgba(13, 110, 253, 0); }
        }

        .ai-widget-panel {
            position: fixed;
            inset-inline-end: 1.5rem;
            bottom: 6rem;
            width: 360px;
            max-width: calc(100vw - 2rem);
            height: 520px;
            max-height: calc(100vh - 8rem);
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 12px 40px rgba(0,0,0,0.25);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            z-index: 1089;
            font-family: 'Cairo', sans-serif;
        }

        .ai-widget-header {
            background: linear-gradient(135deg, #0d6efd, #0a58ca);
            color: #fff;
            padding: 0.75rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .ai-widget-status {
            font-size: 0.7rem;
            opacity: 0.9;
        }

        .ai-widget-dot {
            display: inline-block;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #4ade80;
            margin-inline-end: 3px;
        }

        .ai-widget-icon-btn {
            background: rgba(255,255,255,0.15);
            border: none;
            color: #fff;
            width: 28px;
            height: 28px;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
        }

        .ai-widget-icon-btn:hover {
            background: rgba(255,255,255,0.28);
        }

        .ai-widget-messages {
            flex: 1 1 auto;
            overflow-y: auto;
            padding: 0.85rem;
            background: #f8f9fb;
        }

        .ai-widget-msg {
            max-width: 85%;
            padding: 0.55rem 0.85rem;
            border-radius: 14px;
            margin-bottom: 0.6rem;
            font-size: 0.85rem;
            line-height: 1.55;
            white-space: pre-wrap;
            word-wrap: break-word;
        }

        .ai-widget-msg.user {
            background-color: #0d6efd;
            color: #fff;
            margin-inline-start: auto;
            border-bottom-end-radius: 4px;
        }

        .ai-widget-msg.assistant {
            background-color: #ffffff;
            color: #212529;
            border: 1px solid #e3e6ec;
            margin-inline-end: auto;
            border-bottom-start-radius: 4px;
        }

        .ai-widget-msg.typing {
            background-color: #ffffff;
            border: 1px solid #e3e6ec;
            color: #6c757d;
            font-style: italic;
        }

        .ai-widget-chips {
            display: flex;
            gap: 0.4rem;
            padding: 0.5rem 0.65rem;
            overflow-x: auto;
            border-top: 1px solid #eef0f4;
            background: #fff;
            white-space: nowrap;
        }

        .ai-widget-chip {
            flex: 0 0 auto;
            background: #eef3ff;
            color: #0d6efd;
            border: 1px solid #d7e4ff;
            border-radius: 999px;
            padding: 0.3rem 0.75rem;
            font-size: 0.72rem;
        }

        .ai-widget-chip:hover {
            background: #dbe8ff;
        }

        .ai-widget-input-area {
            display: flex;
            gap: 0.5rem;
            padding: 0.65rem;
            border-top: 1px solid #eef0f4;
            background: #fff;
        }

        .ai-widget-send-btn {
            flex: 0 0 auto;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            border: none;
            background: #0d6efd;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .ai-widget-send-btn:disabled {
            opacity: 0.7;
        }

        @@media (max-width: 480px) {
            .ai-widget-panel {
                width: calc(100vw - 1.5rem);
                inset-inline-end: 0.75rem;
                bottom: 5.5rem;
            }

            .ai-widget-fab {
                inset-inline-end: 1rem;
                bottom: 1rem;
            }
        }
    </style>

    <script>
        (function () {
            const STORAGE_KEY = 'aiWidgetState';

            const fab = document.getElementById('aiWidgetFab');
            const panel = document.getElementById('aiWidgetPanel');
            const minimizeBtn = document.getElementById('aiWidgetMinimizeBtn');
            const closeBtn = document.getElementById('aiWidgetCloseBtn');
            const messagesEl = document.getElementById('aiWidgetMessages');
            const form = document.getElementById('aiWidgetForm');
            const input = document.getElementById('aiWidgetInput');
            const sendBtn = document.getElementById('aiWidgetSendBtn');
            const sendIcon = document.getElementById('aiWidgetSendIcon');
            const spinner = document.getElementById('aiWidgetSpinner');
            const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
            const askUrl = '@Url.Action("Ask", "AiAssistant")';

            function loadState() {
                try {
                    const raw = sessionStorage.getItem(STORAGE_KEY);
                    return raw ? JSON.parse(raw) : { open: false, history: [] };
                } catch (e) {
                    return { open: false, history: [] };
                }
            }

            function saveState(state) {
                try {
                    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(state));
                } catch (e) { /* storage unavailable - degrade silently */ }
            }

            let state = loadState();

            function renderHistory() {
                messagesEl.querySelectorAll('.ai-widget-msg.restored').forEach(function (el) { el.remove(); });
                state.history.forEach(function (turn) {
                    appendMessage(turn.text, turn.role === 'model' ? 'assistant' : 'user', true);
                });
            }

            function appendMessage(text, role, restored) {
                const bubble = document.createElement('div');
                bubble.className = 'ai-widget-msg ' + role + (restored ? ' restored' : '');
                bubble.textContent = text;
                messagesEl.appendChild(bubble);
                messagesEl.scrollTop = messagesEl.scrollHeight;
                return bubble;
            }

            function showTyping() {
                const bubble = document.createElement('div');
                bubble.className = 'ai-widget-msg typing';
                bubble.id = 'aiWidgetTyping';
                bubble.textContent = 'المساعد يكتب...';
                messagesEl.appendChild(bubble);
                messagesEl.scrollTop = messagesEl.scrollHeight;
            }

            function hideTyping() {
                const el = document.getElementById('aiWidgetTyping');
                if (el) el.remove();
            }

            function openPanel() {
                panel.classList.remove('d-none');
                state.open = true;
                saveState(state);
                input.focus();
            }

            function closePanel() {
                panel.classList.add('d-none');
                state.open = false;
                saveState(state);
            }

            fab.addEventListener('click', function () {
                if (panel.classList.contains('d-none')) {
                    openPanel();
                } else {
                    closePanel();
                }
            });

            minimizeBtn.addEventListener('click', closePanel);
            closeBtn.addEventListener('click', closePanel);

            async function sendMessage(message) {
                appendMessage(message, 'user');
                state.history.push({ role: 'user', text: message });
                saveState(state);

                input.value = '';
                input.disabled = true;
                sendBtn.disabled = true;
                sendIcon.classList.add('d-none');
                spinner.classList.remove('d-none');
                showTyping();

                try {
                    const response = await fetch(askUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': tokenInput ? tokenInput.value : ''
                        },
                        body: JSON.stringify({
                            message: message,
                            history: state.history.slice(-8)
                        })
                    });

                    const data = await response.json();
                    hideTyping();

                    if (data.success) {
                        appendMessage(data.reply, 'assistant');
                        state.history.push({ role: 'model', text: data.reply });
                    } else {
                        appendMessage(data.errorMessage || 'حدث خطأ ما، حاول مرة أخرى.', 'assistant');
                    }
                    saveState(state);
                } catch (err) {
                    hideTyping();
                    appendMessage('تعذر الاتصال بالخادم. تحقق من اتصالك وحاول مرة أخرى.', 'assistant');
                } finally {
                    input.disabled = false;
                    sendBtn.disabled = false;
                    sendIcon.classList.remove('d-none');
                    spinner.classList.add('d-none');
                    input.focus();
                }
            }

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                const message = input.value.trim();
                if (!message) return;
                sendMessage(message);
            });

            document.querySelectorAll('.ai-widget-chip').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    sendMessage(btn.getAttribute('data-question'));
                });
            });

            // Restore persisted state on load
            renderHistory();
            if (state.open) {
                panel.classList.remove('d-none');
            }
        })();
    </script>
}
