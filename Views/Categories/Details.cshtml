@model PharmacyIMS.Models.Category
@{
    ViewData["Title"] = "تفاصيل الفئة";
}

<h3 class="fw-bold mb-4"><i class="bi bi-tag me-2"></i>تفاصيل الفئة</h3>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">اسم الفئة</dt>
            <dd class="col-sm-9">@Model.CategoryName</dd>
            <dt class="col-sm-3">الوصف</dt>
            <dd class="col-sm-9">@Model.Description</dd>
            <dt class="col-sm-3">عدد المنتجات</dt>
            <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Products.Count</span></dd>
        </dl>
    </div>
</div>

<div class="card">
    <div class="card-header fw-bold">المنتجات ضمن هذه الفئة</div>
    <div class="card-body table-responsive">
        <table class="table table-sm">
            <thead><tr><th>SKU</th><th>اسم المنتج</th><th>السعر</th><th>الكمية</th></tr></thead>
            <tbody>
                @foreach (var p in Model.Products)
                {
                    <tr>
                        <td>@p.SKU</td>
                        <td>@p.ProductName</td>
                        <td>@p.UnitPrice.ToString("N2")</td>
                        <td>@p.StockQuantity</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.CategoryID" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>تعديل</a>
    <a asp-action="Index" class="btn btn-secondary">رجوع للقائمة</a>
</div>
