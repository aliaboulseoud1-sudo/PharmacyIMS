@model PharmacyIMS.Models.Category
@{
    ViewData["Title"] = "حذف فئة";
}

<h3 class="fw-bold mb-4 text-danger"><i class="bi bi-exclamation-triangle me-2"></i>تأكيد الحذف</h3>

<div class="alert alert-warning">
    هل أنت متأكد من رغبتك في حذف هذه الفئة؟
    @if (Model.Products.Any())
    {
        <div class="mt-2 fw-bold">تنبيه: توجد @Model.Products.Count منتج مرتبط بهذه الفئة، لن يتم السماح بالحذف حتى يتم نقل أو حذف هذه المنتجات.</div>
    }
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">اسم الفئة</dt>
            <dd class="col-sm-9">@Model.CategoryName</dd>
            <dt class="col-sm-3">الوصف</dt>
            <dd class="col-sm-9">@Model.Description</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="CategoryID" />
    <button type="submit" class="btn btn-danger" onclick="return confirmDelete('سيتم حذف هذه الفئة نهائياً، هل أنت متأكد؟');">
        <i class="bi bi-trash me-1"></i> نعم، احذف
    </button>
    <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
</form>
