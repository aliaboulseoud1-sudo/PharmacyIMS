@model DashboardViewModels
@{
    ViewData["Title"] = "لوحة التحكم";
}

<h3 class="fw-bold mb-4"><i class="bi bi-speedometer2 me-2"></i>لوحة التحكم التنفيذية</h3>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card kpi-card border-start border-4 border-primary">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">إجمالي المنتجات</div>
                    <div class="fs-4 fw-bold">@Model.TotalProducts</div>
                </div>
                <i class="bi bi-box-seam fs-1 text-primary opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card kpi-card border-start border-4 border-info">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">إجمالي الفئات</div>
                    <div class="fs-4 fw-bold">@Model.TotalCategories</div>
                </div>
                <i class="bi bi-tags fs-1 text-info opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card kpi-card border-start border-4 border-secondary">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">إجمالي الموردين</div>
                    <div class="fs-4 fw-bold">@Model.TotalSuppliers</div>
                </div>
                <i class="bi bi-truck fs-1 text-secondary opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card kpi-card border-start border-4 border-success">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">إجمالي الكمية بالمخزون</div>
                    <div class="fs-4 fw-bold">@Model.TotalStockQuantity</div>
                </div>
                <i class="bi bi-boxes fs-1 text-success opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <div class="card kpi-card border-start border-4 border-danger">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">تنبيهات نقص المخزون</div>
                    <div class="fs-4 fw-bold">@Model.LowStockCount</div>
                </div>
                <i class="bi bi-exclamation-triangle fs-1 text-danger opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <div class="card kpi-card border-start border-4 border-success">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">إجمالي إيرادات المبيعات</div>
                    <div class="fs-4 fw-bold">@Model.TotalSalesRevenue.ToString("N2")</div>
                </div>
                <i class="bi bi-graph-up-arrow fs-1 text-success opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card kpi-card border-start border-4 border-warning">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">إجمالي تكلفة المشتريات</div>
                    <div class="fs-4 fw-bold">@Model.TotalPurchaseCost.ToString("N2")</div>
                </div>
                <i class="bi bi-cart-check fs-1 text-warning opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header fw-bold"><i class="bi bi-award me-1"></i> الأصناف الأكثر مبيعاً (Top 5)</div>
            <div class="card-body">
                @if (Model.TopSellingProducts.Any())
                {
                    <canvas id="topSellingChart" height="230"></canvas>
                }
                else
                {
                    <p class="text-muted text-center py-5 mb-0">لا توجد بيانات مبيعات كافية بعد لعرض هذا الرسم البياني.</p>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header fw-bold"><i class="bi bi-graph-up me-1"></i> المبيعات مقابل المشتريات (آخر 6 أشهر)</div>
            <div class="card-body">
                <canvas id="salesVsPurchasesChart" height="230"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-bold text-danger"><i class="bi bi-exclamation-triangle me-1"></i> تنبيه: أصناف منخفضة المخزون</div>
    <div class="card-body table-responsive">
        @if (Model.LowStockProducts.Any())
        {
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>الصنف</th>
                        <th>الفئة</th>
                        <th>الكمية المتبقية</th>
                        <th>حد إعادة الطلب</th>
                        <th class="text-center">إجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.LowStockProducts)
                    {
                        <tr class="table-danger">
                            <td class="fw-semibold">@p.ProductName <span class="text-muted small">(@p.SKU)</span></td>
                            <td>@p.Category?.CategoryName</td>
                            <td>@p.StockQuantity</td>
                            <td>@p.LowStockThreshold</td>
                            <td class="text-center">
                                <a asp-controller="Purchases" asp-action="Create" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-cart-plus"></i> إعادة الطلب
                                </a>
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@p.ProductID" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted text-center mb-0">لا توجد أصناف منخفضة المخزون حالياً. المخزون في وضع جيد.</p>
        }
    </div>
</div>

<div class="card">
    <div class="card-header fw-bold"><i class="bi bi-clock-history me-1"></i> سجل الأنشطة الأخيرة</div>
    <div class="card-body">
        @if (Model.RecentActivity.Any())
        {
            <ul class="list-group list-group-flush">
                @foreach (var activity in Model.RecentActivity)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge @activity.BadgeClass me-2"><i class="bi @activity.IconClass"></i> @activity.Type</span>
                            @activity.Description
                            <span class="text-muted small ms-2">@activity.Date.ToString("yyyy-MM-dd")</span>
                        </div>
                        <span class="fw-bold">@activity.Amount.ToString("N2") جنيه</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted text-center mb-0">لا توجد أنشطة مسجلة بعد.</p>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        @if (Model.TopSellingProducts.Any())
        {
            <text>
            const topSellingCtx = document.getElementById('topSellingChart');
            new Chart(topSellingCtx, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.TopSellingProducts.Select(p => p.ProductName))),
                    datasets: [{
                        label: 'الكمية المباعة',
                        data: @Html.Raw(Json.Serialize(Model.TopSellingProducts.Select(p => p.TotalQuantitySold))),
                        backgroundColor: ['#0d6efd', '#20c997', '#ffc107', '#fd7e14', '#6f42c1'],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom', labels: { font: { family: 'Cairo' } } }
                    }
                }
            });
            </text>
        }

        const trendCtx = document.getElementById('salesVsPurchasesChart');
        new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.MonthLabels)),
                datasets: [
                    {
                        label: 'المبيعات',
                        data: @Html.Raw(Json.Serialize(Model.MonthlySales)),
                        borderColor: '#198754',
                        backgroundColor: 'rgba(25,135,84,0.15)',
                        tension: 0.3,
                        fill: true
                    },
                    {
                        label: 'المشتريات',
                        data: @Html.Raw(Json.Serialize(Model.MonthlyPurchases)),
                        borderColor: '#fd7e14',
                        backgroundColor: 'rgba(253,126,20,0.15)',
                        tension: 0.3,
                        fill: true
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'bottom', labels: { font: { family: 'Cairo' } } }
                },
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });
    </script>
}
