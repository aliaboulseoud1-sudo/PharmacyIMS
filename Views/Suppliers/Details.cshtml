@model PharmacyIMS.Models.Supplier

@{
    ViewData["Title"] = "تفاصيل المورد";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h3 class="mb-0"><i class="bi bi-truck"></i> @Model.SupplierName</h3>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.SupplierID" class="btn btn-outline-warning">
            <i class="bi bi-pencil"></i> تعديل
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right"></i> رجوع للقائمة
        </a>
    </div>
</div>

<div class="card mb-4 p-3 shadow-sm">
    <div class="row g-3">
        <div class="col-md-4"><strong>اسم المسؤول:</strong> @Model.ContactName</div>
        <div class="col-md-4"><strong>الهاتف:</strong> <span dir="ltr">@Model.Phone</span></div>
        <div class="col-md-4"><strong>البريد الإلكتروني:</strong> <span dir="ltr">@Model.Email</span></div>
        <div class="col-12"><strong>العنوان:</strong> @Model.Address</div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h5 class="mb-0">المنتجات الموردة من هذا المورد</h5>
    <a asp-controller="SupplierProducts" asp-action="Create" asp-route-supplierId="@Model.SupplierID"
       class="btn btn-sm btn-primary">
        <i class="bi bi-plus-lg"></i> إضافة منتج موّرد
    </a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>المنتج</th>
                    <th>كود المورد (SKU)</th>
                    <th>سعر التعاقد</th>
                    <th>مدة التوريد (يوم)</th>
                    <th class="text-center">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sp in Model.SupplierProducts)
                {
                    <tr>
                        <td>@sp.Product.ProductName</td>
                        <td>@sp.SupplierSKU</td>
                        <td>@sp.ContractPrice.ToString("0.00")</td>
                        <td>@sp.LeadTimeDays</td>
                        <td class="text-center">
                            <a asp-controller="SupplierProducts" asp-action="Edit" asp-route-id="@sp.SupplierProductID"
                               class="btn btn-sm btn-outline-warning" title="تعديل شروط التعاقد">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-controller="SupplierProducts" asp-action="Delete" asp-route-id="@sp.SupplierProductID"
                                  method="post" class="d-inline"
                                  onsubmit="return confirm('هل أنت متأكد من إلغاء ربط هذا المنتج عن المورد؟');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="إلغاء الربط">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.SupplierProducts.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            لا توجد منتجات مرتبطة بهذا المورد بعد.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
