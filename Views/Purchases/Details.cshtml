@model PharmacyIMS.Models.Purchase
@{
    ViewData["Title"] = "تفاصيل إذن الشراء";
}

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <h3 class="fw-bold"><i class="bi bi-cart-plus me-2"></i>إذن شراء #@Model.PurchaseID.ToString("D5")</h3>
    <div>
        <button type="button" class="btn btn-primary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> طباعة الإذن
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right me-1"></i> عودة لسجل المشتريات
        </a>
    </div>
</div>

<div class="card invoice-card">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
            <div>
                <h4 class="fw-bold mb-0"><i class="bi bi-capsule-pill text-info me-1"></i> PharmacyIMS</h4>
                <small class="text-muted">نظام إدارة مخزون الصيدلية</small>
            </div>
            <div class="text-end">
                <h5 class="mb-1">إذن شراء رقم: #@Model.PurchaseID.ToString("D5")</h5>
                <div class="text-muted">التاريخ: @Model.PurchaseDate.ToString("yyyy-MM-dd")</div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <strong>بيانات المورد:</strong>
                <div>@(Model.Supplier?.SupplierName ?? "مورد محذوف")</div>
                @if (Model.Supplier != null)
                {
                    @if (!string.IsNullOrWhiteSpace(Model.Supplier.ContactName))
                    {
                        <div class="text-muted small">مسؤول التواصل: @Model.Supplier.ContactName</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Supplier.Phone))
                    {
                        <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@Model.Supplier.Phone</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Supplier.Email))
                    {
                        <div class="text-muted small"><i class="bi bi-envelope me-1"></i>@Model.Supplier.Email</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Supplier.Address))
                    {
                        <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i>@Model.Supplier.Address</div>
                    }
                }
            </div>
            <div class="col-md-6 text-md-end">
                <strong>عدد الأصناف:</strong> @Model.PurchaseItems.Count
                &nbsp;|&nbsp;
                <strong>إجمالي الكمية المستلمة:</strong> @Model.PurchaseItems.Sum(i => i.Quantity)
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>المنتج / الدواء</th>
                        <th>SKU</th>
                        <th>الكمية المستلمة</th>
                        <th>سعر الوحدة</th>
                        <th>الإجمالي الفرعي</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rowNum = 1; }
                    @foreach (var item in Model.PurchaseItems)
                    {
                        <tr>
                            <td>@(rowNum++)</td>
                            <td>@(item.Product?.ProductName ?? "منتج محذوف")</td>
                            <td>@(item.Product?.SKU)</td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitCost.ToString("N2") ج.م</td>
                            <td>@item.LineTotal.ToString("N2") ج.م</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="5" class="text-end fw-bold fs-5">الإجمالي الكلي</td>
                        <td class="fw-bold fs-5">@Model.TotalAmount.ToString("N2") ج.م</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="text-center text-muted mt-4 pt-3 border-top">
            تم تحديث كميات المخزون تلقائيًا عند تسجيل هذا الإذن
        </div>
    </div>
</div>

<style>
    @@media print {
        .no-print, nav, .sidebar, #sidebar, .navbar, .toast-container {
            display: none !important;
        }

        .invoice-card {
            border: none !important;
            box-shadow: none !important;
        }

        #page-content-wrapper, main, body, html {
            margin: 0 !important;
            padding: 0 !important;
        }
    }
</style>
