@model CreatePurchaseViewModel
@{
    ViewData["Title"] = "إذن شراء جديد";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold"><i class="bi bi-cart-plus me-2"></i>إذن شراء جديد (استلام بضاعة)</h3>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right me-1"></i> عودة لسجل المشتريات
    </a>
</div>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div id="clientErrorBox" class="alert alert-danger d-none" role="alert"></div>

<form asp-action="Create" method="post" id="purchaseForm">
    @Html.AntiForgeryToken()

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="SupplierID" class="form-label"></label>
                    <select asp-for="SupplierID" asp-items="ViewBag.Suppliers" class="form-select">
                        <option value="">-- اختر المورد --</option>
                    </select>
                    <span asp-validation-for="SupplierID" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PurchaseDate" class="form-label"></label>
                    <input type="date" name="PurchaseDate" id="PurchaseDate" class="form-control"
                           value="@Model.PurchaseDate.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="PurchaseDate" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span class="fw-semibold"><i class="bi bi-boxes me-1"></i> أصناف طلب الشراء</span>
            <button type="button" id="addItemBtn" class="btn btn-sm btn-success">
                <i class="bi bi-plus-circle me-1"></i> إضافة صنف
            </button>
        </div>
        <div class="card-body table-responsive">
            <table class="table align-middle" id="itemsTable">
                <thead>
                    <tr>
                        <th style="min-width:240px">المنتج / الدواء</th>
                        <th>المتوفر حاليًا بالمخزون</th>
                        <th style="width:140px">الكمية</th>
                        <th style="width:160px">سعر الوحدة (شراء)</th>
                        <th>الإجمالي الفرعي</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="itemsBody">

                </tbody>
            </table>
            <p id="emptyItemsMsg" class="text-muted text-center py-3">لا توجد أصناف مضافة بعد. اضغط "إضافة صنف" للبدء.</p>
        </div>
        <div class="card-footer bg-white text-end">
            <span class="fs-5">إجمالي إذن الشراء: <strong id="grandTotal">0.00</strong> ج.م</span>
        </div>
    </div>

    <div class="text-end mb-5">
        <button type="submit" class="btn btn-primary btn-lg">
            <i class="bi bi-check-circle me-1"></i> حفظ إذن الشراء وتحديث المخزون
        </button>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const productsData = @Html.Raw(ViewBag.ProductsJson ?? "[]");

        let rowCounter = 0;
        const itemsBody = document.getElementById('itemsBody');
        const emptyItemsMsg = document.getElementById('emptyItemsMsg');
        const grandTotalEl = document.getElementById('grandTotal');
        const clientErrorBox = document.getElementById('clientErrorBox');

        function buildProductOptions(selectedId) {
            let html = '<option value="">-- اختر المنتج --</option>';
            productsData.forEach(p => {
                const selected = (selectedId && Number(selectedId) === p.productID) ? 'selected' : '';
                html += `<option value="${p.productID}" ${selected}>${p.productName} (${p.sku})</option>`;
            });
            return html;
        }

        function addRow() {
            const idx = rowCounter++;
            const tr = document.createElement('tr');
            tr.dataset.rowIndex = idx;
            tr.innerHTML = `
                <td>
                    <select class="form-select product-select" name="Items[${idx}].ProductID">
                        ${buildProductOptions()}
                    </select>
                </td>
                <td class="stock-cell text-muted">-</td>
                <td>
                    <input type="number" min="1" step="1" class="form-control qty-input" name="Items[${idx}].Quantity" value="1" />
                </td>
                <td>
                    <input type="number" min="0.01" step="0.01" class="form-control cost-input" name="Items[${idx}].UnitCost" value="0.00" />
                </td>
                <td class="line-total fw-semibold">0.00</td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-danger remove-row-btn">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            `;
            itemsBody.appendChild(tr);
            wireRow(tr);
            toggleEmptyMessage();
        }

        function wireRow(tr) {
            const select = tr.querySelector('.product-select');
            const qtyInput = tr.querySelector('.qty-input');
            const costInput = tr.querySelector('.cost-input');

            select.addEventListener('change', () => onProductChange(tr));
            qtyInput.addEventListener('input', () => recalcRow(tr));
            costInput.addEventListener('input', () => recalcRow(tr));
            tr.querySelector('.remove-row-btn').addEventListener('click', () => {
                tr.remove();
                renumberRows();
                toggleEmptyMessage();
                recalcGrandTotal();
            });
        }

        function getProduct(productId) {
            return productsData.find(p => p.productID === Number(productId));
        }

        function onProductChange(tr) {
            const select = tr.querySelector('.product-select');
            const product = getProduct(select.value);
            const stockCell = tr.querySelector('.stock-cell');
            const costInput = tr.querySelector('.cost-input');

            if (product) {
                stockCell.textContent = product.stockQuantity;
                // Suggest the current sale price as a starting point for the purchase cost (editable)
                if (!costInput.dataset.userEdited) {
                    costInput.value = product.unitPrice.toFixed(2);
                }
            } else {
                stockCell.textContent = '-';
            }
            recalcRow(tr);
        }

        function recalcRow(tr) {
            const qtyInput = tr.querySelector('.qty-input');
            const costInput = tr.querySelector('.cost-input');
            const lineTotalCell = tr.querySelector('.line-total');

            qtyInput.classList.remove('is-invalid');
            costInput.classList.remove('is-invalid');

            let qty = parseInt(qtyInput.value, 10);
            if (isNaN(qty) || qty < 1) { qty = 0; qtyInput.classList.add('is-invalid'); }

            let cost = parseFloat(costInput.value);
            if (isNaN(cost) || cost <= 0) { cost = 0; costInput.classList.add('is-invalid'); }

            lineTotalCell.textContent = (qty * cost).toFixed(2);
            recalcGrandTotal();
        }

        function renumberRows() {
            const rows = itemsBody.querySelectorAll('tr');
            rows.forEach((tr, i) => {
                tr.dataset.rowIndex = i;
                tr.querySelector('.product-select').name = `Items[${i}].ProductID`;
                tr.querySelector('.qty-input').name = `Items[${i}].Quantity`;
                tr.querySelector('.cost-input').name = `Items[${i}].UnitCost`;
            });
            rowCounter = rows.length;
        }

        function recalcGrandTotal() {
            let total = 0;
            itemsBody.querySelectorAll('tr').forEach(tr => {
                const qty = parseInt(tr.querySelector('.qty-input').value, 10) || 0;
                const cost = parseFloat(tr.querySelector('.cost-input').value) || 0;
                total += qty * cost;
            });
            grandTotalEl.textContent = total.toFixed(2);
        }

        function toggleEmptyMessage() {
            const hasRows = itemsBody.querySelectorAll('tr').length > 0;
            emptyItemsMsg.classList.toggle('d-none', hasRows);
        }

        document.getElementById('addItemBtn').addEventListener('click', addRow);

        document.getElementById('purchaseForm').addEventListener('submit', function (e) {
            clientErrorBox.classList.add('d-none');
            clientErrorBox.innerHTML = '';

            const supplierSelect = document.querySelector('[name="SupplierID"]');
            const rows = itemsBody.querySelectorAll('tr');
            const errors = [];

            if (!supplierSelect.value) {
                errors.push('يجب اختيار المورد');
            }

            if (rows.length === 0) {
                errors.push('يجب إضافة صنف واحد على الأقل لطلب الشراء');
            }

            rows.forEach(tr => {
                const select = tr.querySelector('.product-select');
                const qtyInput = tr.querySelector('.qty-input');
                const costInput = tr.querySelector('.cost-input');
                const product = getProduct(select.value);

                if (!select.value) {
                    errors.push('يجب اختيار منتج لكل صنف في الإذن');
                    return;
                }
                const qty = parseInt(qtyInput.value, 10) || 0;
                const cost = parseFloat(costInput.value) || 0;

                if (qty < 1) {
                    errors.push(`الكمية غير صحيحة للمنتج ${product ? product.productName : ''}`);
                }
                if (cost <= 0) {
                    errors.push(`سعر الوحدة غير صحيح للمنتج ${product ? product.productName : ''}`);
                }
            });

            if (errors.length > 0) {
                e.preventDefault();
                showClientError([...new Set(errors)].join('<br />'));
            }
        });

        function showClientError(message) {
            clientErrorBox.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>' + message;
            clientErrorBox.classList.remove('d-none');
            clientErrorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        addRow();
        toggleEmptyMessage();
    </script>
}
