@model SupplierProductViewModel

@{
    ViewData["Title"] = "تعديل شروط التعاقد";
}

<h3 class="mb-4">
    <i class="bi bi-pencil-square"></i> تعديل شروط التعاقد
    <small class="text-muted">- @Model.SupplierName</small>
</h3>

<div class="row">
    <div class="col-md-7">
        <form asp-action="Edit" method="post" class="card p-4 shadow-sm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="SupplierProductID" />
            <input type="hidden" asp-for="SupplierID" />
            <input type="hidden" asp-for="SupplierName" />
            <input type="hidden" asp-for="ProductID" />

            <div class="mb-3">
                <label class="form-label">المنتج</label>
                <input type="text" class="form-control" value="@Model.ProductName" disabled />
            </div>

            <div class="mb-3">
                <label asp-for="SupplierSKU" class="form-label"></label>
                <input asp-for="SupplierSKU" class="form-control" dir="ltr" />
                <span asp-validation-for="SupplierSKU" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ContractPrice" class="form-label"></label>
                <input asp-for="ContractPrice" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="ContractPrice" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LeadTimeDays" class="form-label"></label>
                <input asp-for="LeadTimeDays" class="form-control" type="number" />
                <span asp-validation-for="LeadTimeDays" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> حفظ التعديلات
                </button>
                <a asp-controller="Suppliers" asp-action="Details" asp-route-id="@Model.SupplierID"
                   class="btn btn-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
